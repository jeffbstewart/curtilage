# curtilage server configuration -- protobuf text format
# (proto/curtilage/v1/config.proto).  A typo is a parse error, not a
# silently ignored key.  Credentials are NOT here: the server reads
# CURTILAGE_MQTT_USER and CURTILAGE_MQTT_PASSWORD from the environment.
#
# A household keeps its own copy wherever its deployment config lives
# (a ConfigMap, a compose bind mount); this is the example.

mqtt {
  host: "mosquitto.cameras.svc.cluster.local"
  port: 1883
  client_id: "curtilage"
  subscriptions: "frigate/#"
  publish_prefix: "curtilage"     # <prefix>/available carries the last will
  keepalive { seconds: 30 }
}

recording {
  dir: "/var/lib/curtilage/recordings"   # empty = do not record
  rotate_every { seconds: 86400 }        # one MCAP file per day (UTC)
}

listen: ":9118"                          # /metrics and /healthz

# Media: snapshots come from Frigate's HTTP API; nothing is passed
# through unexamined.  Leave frigate unset to serve no media.
frigate { url: "http://frigate.cameras.svc.cluster.local:5000" }
# Capability links (GET /media/<token>) stay valid this long.  The
# signing keys are environment Secrets, not here: CURTILAGE_MEDIA_KEY
# and, during a rotation, CURTILAGE_MEDIA_KEY_PRIOR.
links { ttl { seconds: 14400 } }

# The in-the-house page (GET /house/): the last day of events with the
# policy engine's verdict and audience -- the tuning tool.  Only these
# subnets may see it; X-Forwarded-For is believed only from the listed
# proxies.  Leave allow_cidrs empty to turn the page off.
house {
  allow_cidrs: "192.168.1.0/24"
  allow_cidrs: "198.51.100.0/24"
  trusted_proxies: "192.168.1.1"
}

# Every time a person reads (the house page) is shown in this zone.
timezone: "America/New_York"

# Occupancy: what is parked where.  Arrivals and departures become
# events; the count is shown on the house page.  Labels default to
# car; the timers to 60s (arrive) and 5m (depart).
occupancy { zone: "side_parking" }
occupancy { zone: "left_parking_space" }
occupancy { zone: "right_parking_space" }
